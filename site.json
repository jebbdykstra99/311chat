  "rail": {
    "kind": "outbound",
    "title": "Room Brief",
    "kicker": "On 311",
    "meta": "National best practice · preview · noindex",
    "footer": "Unofficial helper. Not 911. National tips until you pick a city — then at most one local official link. We do not file your report.",
    "fact": {
      "tag": "FACT",
      "headline": "911 saves lives. 311 fixes the city.",
      "body": "Call 911 for crime in progress, fire, medical emergency, or immediate danger — if unsure, call 911 and let the dispatcher decide. Use 311 (or your city's non-emergency portal) for potholes, streetlights, graffiti, trash, abandoned vehicles, noise, and other non-emergency city services. This rail stays national until you locate; local handoffs never replace this FACT."
    },
    "outbound": [
      {
        "tag": "When to call",
        "headline": "Right call: 911 vs 311",
        "url": "https://www.sf.gov/make-right-call-right-help",
        "snippet": "Official city split used nationwide: 911 for police/fire/medical/crisis; 311 for non-emergency city services, cleaning, graffiti, abandoned vehicles, street repair, and info.",
        "meta": "Best practice · official example · verified 2026-09-25"
      },
      {
        "tag": "How it works",
        "headline": "What a service request is",
        "url": "https://portal.311.nyc.gov/article/?kanumber=KA-03116",
        "snippet": "A service request asks the city to inspect or fix something. You get a confirmation number, an agency SLA, and optional email/SMS status — pattern shared by Open311-style cities.",
        "meta": "Best practice · official example · verified 2026-09-25"
      },
      {
        "tag": "Tips",
        "headline": "Photo + exact spot = faster fix",
        "url": "https://www.denvergov.org/Online-Services-Hub/Report-an-Issue",
        "snippet": "Strong reports include a clear photo, address or cross-streets, and the right category. Re-file if closed but not fixed. Life-or-death stays on 911.",
        "meta": "Best practice · report well · verified 2026-09-25"
      }
